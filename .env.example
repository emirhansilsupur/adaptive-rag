# ==============================================================================
# AdaptiveRAG Environment Configuration
# ==============================================================================

# --- Primary LLM Provider ---
# Supported: openrouter | openai | ollama | gemini | anthropic
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tiered Models (Budget-aware FinOps routing)
# Fast/cheap model for Query Router, Rewriter, CRAG Grader
LLM_FAST_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# Stronger model for Grounded Generation & Tier-2 Citation Entailment
LLM_GENERATION_MODEL=deepseek/deepseek-v3.2
LLM_TEMPERATURE=0.0

# Optional alternative provider keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Budget & Caching Protection ---
# Cache identical LLM prompts locally to avoid burning credits during dev/eval
LLM_CACHE_ENABLED=true
LLM_CACHE_PATH=.adaptiverag_cache/llm_cache.sqlite
# Hard stop for automated eval / batch runs (USD)
MAX_RUN_COST_USD=0.50

# --- Local Multilingual Embeddings & Reranker (FastEmbed ONNX, $0 API cost) ---
# Dense options (TR + EN):
#   - sentence-transformers/paraphrase-multilingual-mpnet-base-v2 (768d, 1.0GB — recommended)
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384d, 0.22GB — ultra-light)
#   - intfloat/multilingual-e5-large (1024d, 2.24GB — max accuracy)
DENSE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
# Reranker options (TR + EN):
#   - BAAI/bge-reranker-v2-m3-int8 (0.57GB — fast quantized SOTA multilingual)
#   - jinaai/jina-reranker-v2-base-multilingual (1.11GB)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8

# --- Qdrant Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=adaptiverag_docs

# --- Web Search Fallback ---
# Primary: Tavily (if key set). Automatic zero-key fallback: DuckDuckGo
TAVILY_API_KEY=
WEB_FALLBACK_ENABLED=true
WEB_FALLBACK_MAX_RESULTS=4

# --- Observability (Langfuse — optional, runs via `make up-full`) ---
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# --- Strategy Config & Logging ---
STRATEGIES_CONFIG_PATH=configs/strategies.yaml
LOG_LEVEL=INFO
