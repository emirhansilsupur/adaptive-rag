# ==============================================================================
# AdaptiveRAG Environment Configuration
# ==============================================================================

# --- Primary LLM Provider ---
# Supported: openrouter | openai | ollama | gemini | anthropic
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tiered Models (Budget-aware FinOps routing)
# Fast/cheap model for Query Router, Rewriter, CRAG Grader
LLM_FAST_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# Stronger model for Grounded Generation & Tier-2 Citation Entailment
LLM_GENERATION_MODEL=deepseek/deepseek-v3.2
LLM_TEMPERATURE=0.0

# Optional alternative provider keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Allow Studio BYOK session-only provider keys via X-Provider-API-Key header (set false in locked multi-tenant envs)
ALLOW_CLIENT_PROVIDER_KEYS=true

# --- Budget & Caching Protection ---
# Cache identical LLM prompts locally to avoid burning credits during dev/eval
LLM_CACHE_ENABLED=true
LLM_CACHE_PATH=.adaptiverag_cache/llm_cache.sqlite
# Hard stop for automated eval / batch runs (USD)
MAX_RUN_COST_USD=0.50

# --- Local Multilingual Embeddings & Reranker (FastEmbed ONNX, $0 API cost) ---
# Dense options (TR + EN):
#   - sentence-transformers/paraphrase-multilingual-mpnet-base-v2 (768d, 1.0GB — recommended)
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384d, 0.22GB — ultra-light)
#   - intfloat/multilingual-e5-large (1024d, 2.24GB — max accuracy)
DENSE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
# Changing either model means re-indexing. Passages record the models that embedded them,
# and the API refuses (HTTP 409) to search or add to a collection indexed with others:
# replace the collection (Studio switch, recreate_collection, or --recreate).
# Reranker options (TR + EN):
#   - BAAI/bge-reranker-v2-m3-int8 (0.57GB — fast quantized SOTA multilingual)
#   - jinaai/jina-reranker-v2-base-multilingual (1.11GB)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8

# --- Qdrant Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=adaptiverag_docs

# --- Hierarchical Parent-Child (Small-to-Big) Retrieval ---
# Opt-in: index fine-grained child chunks (~256 tok) for sharper Dense/BM25/Cross-Encoder
# precision, then deduplicate and expand selected hits into full parent sections (~1000 tok)
# for grounded synthesis. Backward-compatible with flat-chunked collections.
ENABLE_PARENT_CHILD_RETRIEVAL=false
PARENT_MAX_TOKENS=1000
CHILD_MAX_TOKENS=256
CHILD_OVERLAP_TOKENS=40

# --- Adaptive PDF Parsing & 2-Tier OCR (LiteParse + OCRia-nano-1 + Vision-LLM) ---
# Modes:
#   - auto       : Native digital Markdown (~3ms/page, $0) -> Tier-1 local OCRia-nano-1 ONNX ($0)
#                  -> Tier-2 Vision-LLM escalation for degraded scans/handwriting
#   - ocria_nano : Strict 100% local CPU ONNX OCR ($0, privacy-preserving)
#   - vision_llm : Route scanned/complex PDF pages directly to multimodal Vision-LLM
#   - off        : Native digital PDF-to-Markdown only (skip OCR)
PDF_OCR_MODE=auto
PDF_OCR_AUTO_PULL=true
PDF_OCR_MODEL_DIR=.adaptiverag_cache/liteparse
PDF_OCR_VISION_FALLBACK_ENABLED=true
PDF_OCR_VISION_MODEL=google/gemini-2.5-flash
PDF_OCR_DPI=200
PDF_OCR_MAX_PAGES=25
PDF_OCR_MIN_CHARS=32

# --- Web Search Fallback ---
# Primary: Tavily (if key set). Automatic zero-key fallback: DuckDuckGo
TAVILY_API_KEY=
WEB_FALLBACK_ENABLED=true
WEB_FALLBACK_MAX_RESULTS=4

# --- Live URL & Docs Site Ingestion (Firecrawl Local v2 API, $0 local scraping) ---
# Run `firecrawl-local serve` locally on port 3002 (leave empty to disable)
FIRECRAWL_LOCAL_URL=http://localhost:3002
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_SECONDS=60.0
FIRECRAWL_DEFAULT_CRAWL_LIMIT=10
# Keep false in production to block SSRF to localhost/private/metadata IPs
FIRECRAWL_ALLOW_PRIVATE_URLS=false

# --- Observability, Evaluation & Prompt Management (Langfuse v5 OTEL SDK) ---
# Recommended (zero local RAM overhead): Langfuse Cloud Free Tier (https://cloud.langfuse.com)
# Self-hosted option: run `make up-full` (Langfuse v4 stack) and set LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=0.1.0
# Optional versioned Prompt Management (run `make prompts-sync` to seed all 8 templates first;
# safely falls back to local canonical templates whenever disabled or unreachable)
LANGFUSE_PROMPT_MANAGEMENT_ENABLED=false
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300

# --- Production API Security, Rate Limiting & Static SPA Serving ---
# Without API_AUTH_KEY the API runs local-only: it answers requests addressed to localhost,
# 127.0.0.1 or [::1], and browser requests only from CORS_ALLOW_ORIGINS or its own origin.
# Set a strong secret before serving other machines; it then protects all /v1/* endpoints
# (except /v1/health) via X-API-Key or Authorization: Bearer.
API_AUTH_KEY=
# Comma-separated browser origins allowed to call the API (e.g., https://rag.example.com).
# Empty means the Studio dev server below. "*" lets any website call the API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Extra hostnames answered without API_AUTH_KEY (e.g., a LAN name). "*" answers any host,
# so use it only behind your own authenticating proxy.
ALLOWED_HOSTS_WITHOUT_AUTH=
# Optional per-IP sliding-window rate limiting (returns HTTP 429 + Retry-After)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Enable only behind a trusted reverse proxy (NGINX / Envoy / Cloud Load Balancer)
RATE_LIMIT_TRUST_PROXY_HEADERS=false
# Set STATIC_UI_DIR=frontend/dist (configured automatically in Dockerfile) to serve the React SPA
SERVE_STATIC_UI=true
STATIC_UI_DIR=

# --- Input Safety Guardrails ($0 deterministic screening before LLM calls) ---
GUARDRAILS_ENABLED=true
GUARDRAILS_BLOCK_PROMPT_INJECTION=true
# Supported PII policies: redact (replace with [REDACTED_*]) | block (HTTP 400) | off
GUARDRAILS_PII_MODE=redact

# --- Strategy Config, Corpus Sandbox & Logging ---
ALLOWED_CORPUS_ROOT=data
STRATEGIES_CONFIG_PATH=configs/strategies.yaml
LOG_LEVEL=INFO
